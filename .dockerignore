# Keep the build context small and reproducible.
.git
.gitignore
.venv
.venv*
venv
env

# Python caches / build artifacts
__pycache__
*.py[cod]
*.egg-info
build
dist
.pytest_cache
.mypy_cache
.ruff_cache

# Node deps + local frontend build output (the image rebuilds the SPA)
frontend/node_modules
frontend/dist
npm-debug.log*

# Runtime output + local clips (should not bloat the image)
vpv-artifact
vpv-artifacts
_smoke*
_fs_smoke*

# Tests, profiles, docs, editor cruft — not needed at runtime
tests
profiles
*.md
!README.md
.idea
.vscode
*.iml
.DS_Store
Thumbs.db
