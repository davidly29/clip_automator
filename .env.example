# Copy to .env (gitignored) for local runs, or set these as environment
# variables in your Railway service. Auth is ENFORCED only when
# VPV_ADMIN_PASSWORD is set; leave it unset locally to run the panel open.

# Admin login
VPV_ADMIN_USER=admin
VPV_ADMIN_PASSWORD=change-me-to-a-long-random-string

# Signing key for session cookies. Set a fixed random value so sessions
# survive restarts/redeploys. If unset, a random per-process key is used.
VPV_SESSION_SECRET=

# Where clips/uploads/renders are stored (the Docker image defaults to /data).
# VPV_VIEW_DIR=./vpv-artifacts
